# Copy to .env and adjust. Never commit .env.

# API
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# SQL Server (these match the Docker command in the README)
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=DentalHis_2024
DB_DATABASE=DentalHIS

# JWT: use long random strings outside local development
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Minutes of inactivity before a session no longer counts as an active user
ACTIVE_USER_WINDOW_MINUTES=5
